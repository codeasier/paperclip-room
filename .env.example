# Required: the UUID of the company to display.
PAPERCLIP_COMPANY=replace-with-your-company-id

# Paperclip server origin; do not append /api.
PAPERCLIP_BASE=http://127.0.0.1:3100

# Use an existing authorized token file. Never put the token itself here.
# PAPERCLIP_KEY_FILE=/absolute/path/to/paperclip-token.key

# Optional: Hermes transcript database on the machine running this server.
# HERMES_STATE_DB=/absolute/path/to/.hermes/state.db

# Loopback by default. Set 0.0.0.0 only when LAN access is intended.
HOST=127.0.0.1
PORT=3200
